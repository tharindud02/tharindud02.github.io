---
import Section from "./Section.astro";
import { experience } from "@/data/portfolio";
---

<Section id="experience" title="Work Experience" subtitle="My professional journey">
  <div class="relative max-w-5xl mx-auto">
    <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-border/60 -translate-x-1/2" aria-hidden="true"></div>
    <ol class="space-y-12 list-none p-0 m-0">
      {
        experience.map((exp, idx) => (
          <li
            class={`relative flex flex-col md:flex-row items-center gap-8 reveal ${idx % 2 === 0 ? "md:flex-row-reverse" : ""}`}
            style={`transition-delay:${idx * 50}ms`}
          >
            <div class="absolute left-8 md:left-1/2 -translate-x-1/2 top-1/2 -translate-y-1/2 z-20" aria-hidden="true">
              <div class="w-5 h-5 bg-primary rounded-full border-4 border-background shadow-lg shadow-primary/40"></div>
            </div>

            <div class={`flex-1 ${idx % 2 === 0 ? "md:pr-10" : "md:pl-10"} ml-16 md:ml-0`}>
              <article
                class={`bg-background/50 backdrop-blur-xl p-6 rounded-3xl border border-border/60 hover:border-primary/40 transition-colors ${idx % 2 === 0 ? "md:text-left" : "md:text-right"}`}
              >
                <h3 class="text-xl font-bold text-foreground">{exp.role}</h3>
                <p class={`mt-2 mb-4 text-sm text-muted-foreground inline-flex items-center gap-2 ${idx % 2 === 0 ? "" : "md:justify-end md:w-full"}`}>
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="7" width="20" height="14" rx="2"></rect>
                    <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path>
                  </svg>
                  <span>{exp.company}</span>
                </p>
                <p class={`inline-flex items-center gap-2 bg-primary/10 border border-primary/20 px-3.5 py-1.5 rounded-full text-xs font-medium text-primary ${idx % 2 === 0 ? "" : "md:ml-auto"}`}>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                  </svg>
                  <time>{exp.period}</time>
                </p>
                {exp.highlights && exp.highlights.length > 0 && (
                  <ul class={`mt-4 space-y-2 text-sm text-muted-foreground ${idx % 2 === 0 ? "" : "md:text-right md:list-inside"}`}>
                    {exp.highlights.map((highlight) => (
                      <li class="leading-relaxed">{highlight}</li>
                    ))}
                  </ul>
                )}
              </article>
            </div>
            <div class="hidden md:block flex-1" aria-hidden="true"></div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
