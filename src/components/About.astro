---
import Section from "./Section.astro";
import { site, skillGroups } from "@/data/portfolio";

const details = [
  { label: "Email", value: site.email },
  { label: "Location", value: site.location },
  { label: "Role", value: site.title },
  { label: "Focus", value: "Full-Stack Engineering & AI Systems" },
  {
    label: "Education",
    value: "B.Sc. in Physical Science (ICT), University of Sri Jayewardenepura",
  },
];
---

<Section id="about" title="About Me">
  <div class="grid md:grid-cols-2 gap-10 items-start">
    <div class="prose prose-lg dark:prose-invert text-muted-foreground reveal">
      <p class="lead !text-xl !text-foreground !font-medium !mb-6">
        Associate Tech Lead with 6+ years across fintech, wealth management, automotive, and healthcare, building production-grade web platforms, mobile apps, and AI-integrated systems.
      </p>
      <p class="mb-6">
        I ship across the stack: React and Next.js on the front end, React Native and Flutter for mobile, Node.js on the back end, and AWS infrastructure underneath, managed with Terraform and CI/CD (RDS, Lambda, ECS, Amplify, Docker). Recent work spans client platforms like PlayNet and Asia Securities, SaaS platforms like Lendermate, PawStay, and AutoScout, consumer mobile apps like SnapWeight, RenterMate, and BrainBench, and AI-driven products, including LLM pipelines, n8n workflow automations, and Bubble.io no-code builds.
      </p>
      <p>
        I'm strongest when owning delivery end-to-end: technical planning, code reviews, architecture, cloud infrastructure, backend APIs, and frontend UX, for fintech, healthcare, automotive, and SaaS products.
      </p>
    </div>

    <aside class="bg-card rounded-3xl p-8 border border-border space-y-4 reveal" style="transition-delay:100ms" aria-label="Personal details">
      <h3 class="text-2xl font-bold text-foreground mb-2">Personal Details</h3>
      {
        details.map((item) => (
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 py-3 border-b border-border/50 last:border-0">
            <span class="text-muted-foreground font-medium">{item.label}</span>
            <span class="text-foreground font-semibold sm:text-right sm:max-w-[65%]">{item.value}</span>
          </div>
        ))
      }
    </aside>
  </div>

  <div class="mt-16 reveal">
    <h3 class="text-2xl font-bold font-display mb-6">Technical Skills</h3>
    <dl class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-6">
      {
        skillGroups.map((group) => (
          <div class="border-t border-border pt-4">
            <dt class="text-sm font-semibold text-primary mb-1.5">{group.label}</dt>
            <dd class="text-foreground leading-relaxed">{group.items.join(", ")}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
