---
import Section from "./Section.astro";
import { skills } from "@/data/portfolio";

const groupedSkills = skills.reduce<Record<string, typeof skills>>((acc, skill) => {
  if (!acc[skill.category]) acc[skill.category] = [];
  acc[skill.category].push(skill);
  return acc;
}, {});
---

<Section id="skills" title="Professional Skills" subtitle="My technical toolkit">
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      Object.entries(groupedSkills).map(([category, items], idx) => (
        <article
          class="bg-background/40 backdrop-blur-xl rounded-3xl p-6 border border-border/60 hover:border-primary/40 transition-colors reveal"
          style={`transition-delay:${idx * 40}ms`}
        >
          <h3 class="text-xl font-bold mb-5 border-b border-border/50 pb-3">
            <span class="bg-gradient-to-r from-foreground to-primary bg-clip-text text-transparent">{category}</span>
          </h3>
          <ul class="flex flex-wrap gap-2 list-none p-0 m-0">
            {items.map((skill) => (
              <li class="px-3.5 py-2 bg-secondary/40 border border-border/50 rounded-xl text-sm font-medium">
                {skill.name}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
