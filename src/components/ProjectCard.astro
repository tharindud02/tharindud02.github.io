---
import type { Project } from "@/data/portfolio";

interface Props {
  project: Project;
  delayMs?: number;
}

const { project, delayMs = 0 } = Astro.props;

function isValidProjectLink(link: string): boolean {
  const normalized = link.trim();
  if (!normalized || normalized === "#") return false;
  try {
    const parsed = new URL(normalized);
    return parsed.protocol === "http:" || parsed.protocol === "https:";
  } catch {
    return false;
  }
}

function initials(title: string): string {
  const cleaned = title.replace(/[^A-Za-z0-9 ]/g, " ").trim();
  const parts = cleaned.split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "•";
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[1][0]).toUpperCase();
}

const categoryTheme: Record<string, string> = {
  "SaaS Platform": "from-emerald-500/90 to-teal-500/90",
  "Mobile App": "from-sky-500/90 to-blue-500/90",
  "AI & Automation": "from-violet-500/90 to-fuchsia-500/90",
  Web3: "from-amber-500/90 to-orange-500/90",
  "Web Project": "from-slate-500/90 to-zinc-500/90",
};

const hasValidLink = isValidProjectLink(project.link);
const theme = categoryTheme[project.category] ?? "from-primary/90 to-emerald-500/90";
---

<article
  class="group bg-card/60 backdrop-blur-xl rounded-3xl overflow-hidden border border-border/60 hover:border-primary/40 hover:-translate-y-1 transition-all duration-300 flex flex-col h-full reveal"
  style={`transition-delay:${delayMs}ms`}
>
  <div class={`relative h-32 overflow-hidden bg-gradient-to-br ${theme} flex items-center justify-between px-6`}>
    <span class="text-3xl font-bold font-display text-white/95 tracking-tight">{initials(project.title)}</span>
    {project.featured && (
      <span class="px-3 py-1 text-[11px] font-bold uppercase tracking-wide rounded-full bg-white/20 text-white backdrop-blur-sm">
        Featured
      </span>
    )}
    <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(circle at 20% 20%, white 1px, transparent 1px);background-size:16px 16px" aria-hidden="true" />
  </div>
  <div class="p-6 flex flex-col flex-1">
    <div class="flex flex-wrap items-center gap-2 mb-3 text-[11px] font-semibold uppercase tracking-wide">
      <span class="text-primary">{project.category}</span>
      {project.platform && <span class="text-muted-foreground">· {project.platform}</span>}
    </div>
    <h3 class="text-xl font-bold mb-3 font-display group-hover:text-primary transition-colors">{project.title}</h3>
    <p class="text-muted-foreground text-sm mb-5 flex-1 leading-relaxed line-clamp-4">{project.description}</p>
    <ul class="flex flex-wrap gap-2 mb-5 list-none p-0 m-0">
      {project.technologies.map((tech) => (
        <li class="px-3 py-1 text-xs font-medium bg-secondary/50 text-secondary-foreground rounded-full border border-border/50">
          {tech}
        </li>
      ))}
    </ul>
    <div class="flex items-center justify-between gap-3 mt-auto">
      {project.status && <span class="text-xs font-medium text-muted-foreground">{project.status}</span>}
      {hasValidLink && (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm font-semibold text-primary hover:underline"
        >
          {project.linkLabel ?? "Visit"}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <path d="M15 3h6v6" />
            <path d="m10 14 11-11" />
          </svg>
        </a>
      )}
    </div>
  </div>
</article>
