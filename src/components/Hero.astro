---
import { Image } from "astro:assets";
import portfolioImage from "@/assets/images/portfolio.webp";
import { site } from "@/data/portfolio";
---

<section id="hero" class="min-h-screen flex items-center pt-24 pb-16 relative overflow-hidden">
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-0 right-0 w-[min(800px,90vw)] h-[min(800px,90vw)] bg-primary/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-[min(700px,80vw)] h-[min(700px,80vw)] bg-sky-500/10 rounded-full blur-3xl"></div>
    <div
      class="absolute inset-0 opacity-[0.15]"
      style="background-image:linear-gradient(rgba(16,185,129,0.12) 1px, transparent 1px),linear-gradient(90deg, rgba(16,185,129,0.12) 1px, transparent 1px);background-size:48px 48px"
    >
    </div>
  </div>

  <div class="container mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-12 items-center relative z-10">
    <div class="space-y-8 animate-fade-up">
      <div class="space-y-5">
        <p class="text-primary font-medium tracking-wide text-sm sm:text-base uppercase">Hello, I'm</p>
        <h1 class="text-5xl sm:text-7xl lg:text-8xl font-bold font-display leading-[1.05]">
          <span class="bg-gradient-to-r from-foreground via-foreground to-primary bg-clip-text text-transparent">
            Tharindu
          </span>
          <br />
          <span class="text-muted-foreground">Damith.</span>
        </h1>
        <p class="text-lg sm:text-xl text-muted-foreground max-w-lg leading-relaxed">
          Senior Software Engineer focused on
          <span class="text-foreground font-semibold">Full-Stack & AI Systems</span>
          with 8+ years shipping production-grade products.
        </p>
      </div>

      <div class="flex flex-wrap gap-4">
        <a
          href="#projects"
          class="px-7 py-3.5 rounded-full bg-primary text-primary-foreground font-bold inline-flex items-center gap-2 shadow-lg shadow-primary/20 hover:opacity-95 transition-opacity"
        >
          View My Work
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
        <a
          href="#contact"
          class="px-7 py-3.5 rounded-full border border-border/60 bg-background/50 font-semibold inline-flex items-center gap-2 hover:border-primary/50 transition-colors"
        >
          Contact Me
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M13 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="flex items-center gap-4 pt-2">
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-full inline-flex items-center justify-center border border-border/60 bg-background/50 hover:border-primary hover:text-primary transition-colors"
          aria-label="GitHub profile"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.74.5 12.02c0 5.1 3.29 9.42 7.86 10.95.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.53-1.36-1.3-1.72-1.3-1.72-1.06-.73.08-.72.08-.72 1.17.08 1.79 1.21 1.79 1.21 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.12 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.42.36.79 1.08.79 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.21.68.8.56A10.52 10.52 0 0 0 23.5 12C23.5 5.74 18.27.5 12 .5Z"></path>
          </svg>
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 rounded-full inline-flex items-center justify-center border border-border/60 bg-background/50 hover:border-primary hover:text-primary transition-colors"
          aria-label="LinkedIn profile"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.23 0Z"></path>
          </svg>
        </a>
        <a
          href={`mailto:${site.email}`}
          class="w-12 h-12 rounded-full inline-flex items-center justify-center border border-border/60 bg-background/50 hover:border-primary hover:text-primary transition-colors"
          aria-label="Send email"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 7 9-7"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="relative flex items-center justify-center animate-fade-up" style="animation-delay:80ms">
      <div class="relative w-72 h-72 sm:w-96 sm:h-96 md:w-[500px] md:h-[500px]">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary to-sky-500 rounded-full opacity-20 blur-2xl" aria-hidden="true"></div>
        <div class="absolute inset-4 rounded-full border-2 border-primary/20" aria-hidden="true"></div>
        <div class="absolute inset-8 rounded-full overflow-hidden border-4 border-background shadow-2xl">
          <Image
            src={portfolioImage}
            alt={`${site.shortName}, Senior Software Engineer`}
            widths={[288, 384, 512, 720]}
            sizes="(max-width: 640px) 224px, (max-width: 768px) 320px, 436px"
            width={720}
            height={720}
            format="webp"
            quality={78}
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-[filter] duration-500"
          />
        </div>
        <div class="absolute top-8 right-4 bg-card/90 border border-border px-4 py-2 rounded-2xl shadow-lg animate-float">
          <span class="font-bold text-sm">8+ Years</span>
        </div>
        <div class="absolute bottom-12 left-0 bg-card/90 border border-border px-4 py-2 rounded-2xl shadow-lg animate-float" style="animation-delay:1s">
          <span class="font-bold text-sm">Full Stack</span>
        </div>
      </div>
    </div>
  </div>
</section>
