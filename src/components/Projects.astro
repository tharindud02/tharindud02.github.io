---
import Section from "./Section.astro";
import ProjectCard from "./ProjectCard.astro";
import { projects, additionalProjects } from "@/data/portfolio";

const sorted = [...projects].sort((a, b) => Number(!!b.featured) - Number(!!a.featured));
---

<Section
  id="projects"
  title="Featured Projects"
  subtitle="Production systems across AI, SaaS, mobile, and Web3, shipped end-to-end"
>
  <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
    {sorted.map((project, idx) => <ProjectCard project={project} delayMs={(idx % 8) * 30} />)}
  </div>

  {
    additionalProjects.length > 0 && (
      <div class="mt-20 reveal">
        <header class="mb-10 md:mb-14">
          <h3 class="text-3xl md:text-4xl font-bold font-display mb-3 text-gradient">Additional Work</h3>
          <p class="text-muted-foreground max-w-2xl">Earlier client and agency projects across web and ecommerce.</p>
        </header>
        <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-4">
          {additionalProjects.map((project, idx) => <ProjectCard project={project} delayMs={(idx % 8) * 30} />)}
        </div>
      </div>
    )
  }
</Section>
